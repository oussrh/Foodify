{
  "name": "foodify",
  "version": "1.0.0",
  "description": "AR menu platform",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "node scripts/codemods/shape-exemptions.mjs --check && eslint . --max-warnings=0",
    "type-check": "tsc --noEmit",
    "postinstall": "prisma generate",
    "prisma": "prisma",
    "db:seed": "prisma db seed",
    "db:setup": "prisma generate && prisma db push --force-reset --accept-data-loss && prisma db seed",
    "vercel-build": "prisma generate && next build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:changed": "vitest run --coverage --changed origin/main --passWithNoTests",
    "e2e": "playwright test",
    "test:integration": "node scripts/ci/integration.mjs",
    "contrast": "vitest run test/contrast.test.ts",
    "format:check": "prettier --check --end-of-line auto .",
    "graph": "depcruise app components lib auth.ts proxy.ts --config .dependency-cruiser.cjs --ignore-known --output-type err",
    "graph:mermaid": "depcruise app components lib --config .dependency-cruiser.cjs --output-type mermaid",
    "dead": "knip --max-issues 0",
    "standards": "abatty ratchet",
    "standards:baseline": "abatty baseline",
    "gate": "abatty gate",
    "gate:fast": "abatty gate --fast",
    "hooks:install": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.9.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "^7.10.0",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.47.0",
    "next": "^16.3.5",
    "next-auth": "5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "otplib": "^13.5.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.88.0",
    "resend": "^6.28.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.13.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.1",
    "abatty": "github:Synovitec/abatty#6fc516c70d20907facb95b59daca352e50ba3126",
    "dependency-cruiser": "^18.4.0",
    "dotenv": "^18.0.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.5",
    "eslint-plugin-jsdoc": "^64.5.4",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "knip": "^6.37.0",
    "postcss": "^8.5.28",
    "prettier": "^3.9.8",
    "prisma": "7.10.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  },
  "license": "MIT",
  "type": "module",
  "pnpm": {
    "overrides": {
      "deepmerge-ts": "^8.0.2",
      "mysql2": "^3.24.4"
    }
  }
}
