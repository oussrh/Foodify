{
  "name": "foodify",
  "version": "1.0.0",
  "description": "AR menu platform",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "postinstall": "prisma generate",
    "prisma": "prisma",
    "db:seed": "prisma db seed",
    "db:setup": "prisma generate && prisma db push --force-reset --accept-data-loss && prisma db seed",
    "vercel-build": "prisma generate && next build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:changed": "vitest run --coverage --changed origin/main --passWithNoTests",
    "format:check": "prettier --check --end-of-line auto .",
    "graph": "depcruise app components lib auth.ts middleware.ts --config .dependency-cruiser.cjs --ignore-known --output-type err",
    "graph:mermaid": "depcruise app components lib --config .dependency-cruiser.cjs --output-type mermaid",
    "dead": "knip --max-issues 0",
    "standards": "abatty ratchet",
    "standards:baseline": "abatty baseline",
    "gate": "abatty gate",
    "gate:fast": "abatty gate --fast",
    "hooks:install": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^1.6.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.1.1",
    "@prisma/client": "^6.12.0",
    "@radix-ui/react-alert-dialog": "^1.1.14",
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-slot": "^1.2.3",
    "bcryptjs": "^3.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.525.0",
    "next": "^15.4.1",
    "next-auth": "^5.0.0-beta.29",
    "next-themes": "^0.4.6",
    "otplib": "^12.0.1",
    "prisma": "^6.12.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.60.0",
    "resend": "^4.6.0",
    "sonner": "^2.0.6",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.0.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.14",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitest/coverage-v8": "^5.0.1",
    "abatty": "github:Synovitec/abatty",
    "autoprefixer": "^10.4.20",
    "dependency-cruiser": "^18.3.1",
    "eslint": "^9.31.0",
    "eslint-config-next": "^15.4.1",
    "knip": "^6.37.0",
    "postcss": "^8.4.49",
    "prettier": "^3.9.8",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "vitest": "^5.0.1"
  },
  "license": "MIT",
  "type": "module",
  "prisma": {
    "seed": "node prisma/seed.js"
  }
}
