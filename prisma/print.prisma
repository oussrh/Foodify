// prisma/print.prisma
// Kitchen tickets on paper: a restaurant's network printers and the jobs each one owes. A printer
// is not driven from a browser: it asks our server for work (Epson Server Direct Print), naming
// itself by the secret in the address its owner typed into it, so nothing on the restaurant's
// network has to be reachable and nothing has to run on a tablet for paper to come out. A job is
// written in the same transaction as the ticket, the cancel or the removal it prints, and rendered
// when the printer asks, from the rows as they stand.

// When a ticket prints: as soon as it arrives, so the paper is the kitchen's call; or when the
// kitchen accepts it on the board, so an order from a guest's phone is looked at first.
enum PrintTrigger {
  ARRIVAL
  ACCEPT
}

enum PrintJobKind {
  // The ticket: what to cook, for which table.
  TICKET
  // What to stop: the whole ticket, or `quantity` of one line (the change row says which). Only
  // ever printed on a printer that was given the ticket, so the kitchen never reads a cancel for
  // something it never saw.
  CANCEL
  // A test page from Settings, to see that a printer is set up: no ticket behind it.
  TEST
}

enum PrintJobStatus {
  PENDING
  // Handed to the printer; waiting for it to say whether the paper came out. A job the printer
  // never answers for is handed out again (lib/print/job-rules.ts).
  SENT
  PRINTED
  // Every attempt was spent; Reprint puts it back.
  FAILED
}

// One printer. `tokenHash` is the SHA-256 of the secret in the address the printer polls; the
// secret itself is shown once, when the printer is added or its address renewed, and never stored.
model Printer {
  id           String     @id @default(uuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name         String
  tokenHash    String     @unique
  // The last time it asked for work: how the board and the settings tell a printer that is off.
  lastSeenAt   DateTime?
  // What went wrong last, in the printer's words made plain (paper out, cover open); never a secret.
  lastError    String?
  createdAt    DateTime   @default(now())
  jobs         PrintJob[]

  @@index([restaurantId])
}

// One piece of paper owed to one printer. `orderId` is the ticket (null only for a TEST page);
// `changeId` the change a CANCEL prints (null for a whole ticket cancelled on the board, which
// writes no change row). A printer
// is handed its jobs in the order they were written (`seq`), so a cancel never comes out before
// its ticket.
model PrintJob {
  id         String         @id @default(uuid())
  seq        Int            @unique @default(autoincrement())
  printerId  String
  printer    Printer        @relation(fields: [printerId], references: [id], onDelete: Cascade)
  orderId    String?
  order      Order?         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  changeId   String?
  change     OrderChange?   @relation(fields: [changeId], references: [id], onDelete: Cascade)
  kind       PrintJobKind
  status     PrintJobStatus @default(PENDING)
  attempts   Int            @default(0)
  sentAt     DateTime?
  printedAt  DateTime?
  lastAnswer String?
  createdAt  DateTime       @default(now())

  @@index([printerId, status, seq])
  @@index([orderId])
}
