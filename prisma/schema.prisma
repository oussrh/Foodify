// prisma/schema.prisma
datasource db {
  provider = "postgresql"
}

// Prisma 7: a TypeScript client generated into generated/prisma (gitignored, rebuilt by
// `prisma generate` on install and build); the connection URL is in prisma.config.ts.
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

enum Locale {
  en
  fr
}

enum UserRole {
  SUPER_ADMIN
  RESTAURANT_ADMIN
  // A tablet in the kitchen, not a person: it signs in with a password, never a second factor,
  // and may do one thing only — work its restaurant's order board (lib/auth-guard's
  // requireBoardAccess). Every management guard refuses it.
  KITCHEN
  // Someone on the floor, taking an order for a guest who would rather not use their own phone.
  // Places orders and reads the board; it cannot move an order along (that is the kitchen's), and
  // every management guard refuses it.
  WAITER
}

enum DeviceType {
  iOS
  Android
  Other
}

model Restaurant {
  id                String             @id @default(uuid())
  name              String
  slug              String             @unique
  // The short name this restaurant goes by in a link handed to a device (`lib/restaurant-code.ts`):
  // six Crockford characters, assigned once and never changed. The slug follows the restaurant's
  // name and would break a tab left open on the pass when somebody renames it; this does not.
  code              String             @unique
  email             String?
  phone             String?
  tagline           String?
  logoUrl           String?
  colorTheme        String?
  defaultLocale     Locale
  // Address Information
  streetAddress     String?
  city              String?
  state             String?
  postalCode        String?
  country           String?
  // Additional Business Information
  website           String?
  description       String?
  cuisineType       String?
  // The dietary attributes this restaurant offers: keys of DIETARY_OPTIONS (lib/menu.ts). The dish
  // forms offer these and the public menu shows these; a new restaurant starts with all of them.
  dietaryOptions    String[]           @default(["vegetarian", "vegan", "halal", "gluten_free", "spicy"])
  openingHours      String? // JSON string with operating hours
  socialMedia       String? // JSON string with social media links
  socialDisplay     String             @default("icons") // icons | text: how the menu footer shows the social links
  // Ordering (Settings → General): with it on, the public menu shows the cart and POST /api/orders
  // takes an order; nextOrderNumber is the number the next order gets, incremented atomically.
  orderingEnabled   Boolean            @default(false)
  nextOrderNumber   Int                @default(1)
  // How many tables the room has: the per-table QR sheet makes one code per table (1..N), each
  // opening the menu with its number, and 0 means no per-table codes.
  tableCount        Int                @default(0)
  // The restaurant's own clock (an IANA zone, lib/time-zone.ts): when a sold-out dish comes back
  // (its 04:00) and how Insights cuts its days and hours. UTC until a manager sets it, which is
  // what every figure used before there was a setting.
  timeZone          String             @default("UTC")
  // Deprecated, unused: POS is available to every restaurant; to be dropped with the subscription-plan work.
  posEnabled        Boolean            @default(false)
  // Design/Branding
  coverImageUrl     String?
  coverImageStyle   String? // "cover" or "repeat"
  secondaryColor    String?
  fontFamily        String?
  googleFontUrl     String? // Google Fonts URL for easy implementation
  menuTheme         String             @default("system") // system | light | dark: appearance of the public menu
  // Business Settings
  currency          String? // e.g., "USD", "EUR", "GBP", "CAD"
  currencySymbol    String? // e.g., "$", "€", "£", "C$"
  createdAt         DateTime           @default(now())
  users             User[]
  categories        MenuCategory[]
  dishes            Dish[]
  orders            Order[]
  cartAdds          CartAdd[]
  pushSubscriptions PushSubscription[]
  orderChanges      OrderChange[]
  posConnection     PosConnection?
  posOutbox         PosOutbox[]
}

model User {
  id                      String             @id @default(uuid())
  // Every account has one, but only a person's is an address anyone reads: a device account's is
  // derived from its username on the reserved `.invalid` domain, which can never be routed.
  email                   String             @unique
  // How a device account signs in. People sign in with their address and have none; a tablet or a
  // waiter has no mailbox, so they are given a name instead.
  username                String?            @unique
  emailVerified           DateTime?
  passwordHash            String
  mfaEnabled              Boolean            @default(false) // the second factor is opt-in: off, a password alone opens a session
  totpSecret              String?
  emailOtpCode            String?
  emailOtpExpires         DateTime?
  newEmail                String?
  emailChangeToken        String?
  emailChangeTokenExpires DateTime?
  emailVerifyToken        String?
  emailVerifyTokenExpires DateTime?
  role                    UserRole
  restaurants             Restaurant[]
  activityLogs            ActivityLog[]
  ordersPlaced            Order[]            @relation("OrderPlacedBy")
  billsClosed             Order[]            @relation("OrderClosedBy")
  changesRequested        OrderChange[]      @relation("OrderChangeRequestedBy")
  changesDecided          OrderChange[]      @relation("OrderChangeDecidedBy")
  pushSubscriptions       PushSubscription[]
  createdAt               DateTime           @default(now())
  lastLogin               DateTime?
  passwordResetToken      String?
  passwordResetExpires    DateTime?
  UserSessionLog          UserSessionLog[]
}

model MenuCategory {
  id            String            @id @default(uuid())
  restaurantId  String
  restaurant    Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  nameEn        String
  nameFr        String
  sortOrder     Int
  isActive      Boolean           @default(true)
  subcategories MenuSubcategory[]
}

model MenuSubcategory {
  id         String       @id @default(uuid())
  categoryId String
  category   MenuCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  nameEn     String
  nameFr     String
  sortOrder  Int
  isActive   Boolean      @default(true)
  dishes     Dish[]
}

model Dish {
  id              String           @id @default(uuid())
  restaurantId    String
  restaurant      Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  subcategoryId   String?
  subcategory     MenuSubcategory? @relation(fields: [subcategoryId], references: [id], onDelete: Cascade)
  nameEn          String
  nameFr          String
  descriptionEn   String
  descriptionFr   String
  price           Decimal          @db.Decimal(10, 2)
  imageUrl        String
  usdzUrl         String
  glbUrl          String
  isActive        Boolean          @default(true)
  // Sold out for the rest of the service: the dish stays on the menu, marked, and cannot be
  // ordered until this moment passes. Null is available. `isActive` is the other axis and means
  // "off the menu entirely"; this one is the kitchen running out, and it expires by itself.
  soldOutUntil    DateTime?
  calories        Int?
  isMostPurchased Boolean          @default(false)
  sortOrder       Int
  dietary         String[]         @default([])
  allergens       String[]         @default([])
  createdAt       DateTime         @default(now())
  ingredients     Ingredient[]
  views           DishView[]
  cartAdds        CartAdd[]
  orderLines      OrderLine[]
  posItems        PosItemMap[]
}

model Ingredient {
  id     String @id @default(uuid())
  dishId String
  dish   Dish   @relation(fields: [dishId], references: [id])
  nameEn String
  nameFr String
}

model DishView {
  id         String     @id @default(uuid())
  dishId     String
  dish       Dish       @relation(fields: [dishId], references: [id])
  viewedAt   DateTime   @default(now())
  deviceType DeviceType
  arViewed   Boolean

  // The insights report reads views by restaurant and time, reachable only through the dish.
  @@index([dishId, viewedAt])
}

// A guest putting a dish in their order on the public menu: the step between reading the menu and
// sending an order, which nothing else records (a cart lives in the guest's browser and most are
// never sent). One row per add, so the insights report can say how far down the funnel a menu
// gets. `restaurantId` is carried rather than joined through the dish: every read of this table
// groups by restaurant and time. A waiter's cart is not counted here — a staff order is an order,
// and the report counts it as one.
model CartAdd {
  id           String     @id @default(uuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  dishId       String
  dish         Dish       @relation(fields: [dishId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@index([restaurantId, createdAt])
}

model ActivityLog {
  id        String   @id @default(uuid())
  userId    String
  action    String
  oldEmail  String?
  newEmail  String?
  status    String
  createdAt DateTime @default(now())
  ipAddress String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum OrderStatus {
  NEW
  ACCEPTED
  // The food is up and waiting on the pass. The kitchen's work is finished; the floor's has not
  // started. DONE means a waiter carried it out, which is a different fact and a different person.
  READY
  DONE
  CANCELLED
}

// A guest's order from the public menu (POST /api/orders): the table it is for, the phone the
// confirmation goes to, one line per dish with the name and price as they were, the subtotal the
// server computed. `number` is the short label the kitchen sees (#12), per restaurant, from
// Restaurant.nextOrderNumber. `phone` is personal data: never logged (server/log.ts).
model Order {
  id           String        @id @default(uuid())
  restaurantId String
  restaurant   Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  number       Int
  table        String
  // The guest's number, for the confirmation text. Empty when a waiter took the order at the
  // table: there is nobody to text, and `placedById` says who took it instead.
  phone        String
  placedById   String?
  placedBy     User?         @relation("OrderPlacedBy", fields: [placedById], references: [id], onDelete: SetNull)
  note         String?
  status       OrderStatus   @default(NEW)
  subtotal     Decimal       @db.Decimal(10, 2)
  currency     String? // the restaurant's ISO 4217 code when the order was placed
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  // When the kitchen took the order on and when it went out: stamped once by the board's action,
  // so the history can say how long a table waited before it was started and before it was served.
  // `updatedAt` cannot answer that — it moves again on any later change.
  acceptedAt   DateTime?
  // Stamped when the kitchen called it up, which is the moment the waiter is told about.
  readyAt      DateTime?
  servedAt     DateTime?
  lines        OrderLine[]
  // An addition to a table's bill: the guests asked for more after the first ticket went in. It
  // is its own row with its own number and its own way across the board, so a dish already
  // cooking is not disturbed and no timing resets, and it points at the order that opened the
  // table (never at another addition: lib/table-tab.ts). Null on every order that opens a bill.
  parentId     String?
  parent       Order?        @relation("OrderAdditions", fields: [parentId], references: [id], onDelete: Cascade)
  additions    Order[]       @relation("OrderAdditions")
  // The bill was paid and the table let go (lib/bill-rules.ts): stamped on the order that opened
  // the bill, never on an addition, and by whom. A closed bill is never a table's current one
  // again, so the next order there opens a new bill. Null on every bill nobody closed; those
  // still fall back to the service day and the 90-minute default (lib/table-tab.ts).
  closedAt     DateTime?
  closedById   String?
  closedBy     User?         @relation("OrderClosedBy", fields: [closedById], references: [id], onDelete: SetNull)
  changes      OrderChange[]
  // What the restaurant's POS calls this ticket (the parent's is the bill's), once it has taken
  // it (server/pos/deliver.ts). Null while nothing is connected, and on every order sent before.
  externalId   String?
  // The POS check this ticket was rung up on (its own id for a bill's first ticket, the bill's for
  // an addition), and when the POS said that check was paid. A bill closes from the POS only once
  // every ticket of it that reached the POS is paid, which matters after a merge.
  posCheckId   String?
  posPaidAt    DateTime?
  posOutbox    PosOutbox[]

  @@unique([restaurantId, number])
  @@index([restaurantId, status, createdAt])
  @@index([parentId])
  @@index([restaurantId, posCheckId])
}

// One dish of an order, its name and unit price copied at the time: a dish edited or deleted
// later (dishId is then null) leaves the order as it was placed. `note` is what the guest asked
// for on this dish ("no onions"), one per dish rather than per portion.
model OrderLine {
  id              String        @id @default(uuid())
  orderId         String
  order           Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  dishId          String?
  dish            Dish?         @relation(fields: [dishId], references: [id], onDelete: SetNull)
  nameEn          String
  nameFr          String
  unitPrice       Decimal       @db.Decimal(10, 2)
  quantity        Int
  // How many of `quantity` were taken off after it was sent (cancelled, removed or voided: the
  // OrderChange rows say which and why). The line stays, so the kitchen and the record still see
  // what was asked for; what the guest pays for and what the kitchen makes is the difference.
  removedQuantity Int           @default(0)
  note            String?
  changes         OrderChange[]
}

enum OrderChangeKind {
  CANCEL
  REMOVE
  VOID
  CLOSE
  MERGE
  UNMERGE
  MOVE
}

// A request is a change the kitchen has still to answer (a dish already cooking); everything else
// is applied as it is written, and a refused request stays on record as refused.
// Who made a change: somebody on the staff (`requestedById`, null once the account is gone), or the
// restaurant's POS (a bill paid at the till, server/pos/webhook.ts), which has no account.
enum ChangeSource {
  STAFF
  POS
}

enum OrderChangeStatus {
  APPLIED
  PENDING
  REFUSED
}

// Why a dish or a ticket was taken off (lib/bill-rules.ts CHANGE_REASONS); `other` carries a note.
enum OrderChangeReason {
  changed_mind
  mistake
  too_slow
  unavailable
  other
}

// Every change to a bill after it was sent, in the order it happened: a ticket cancelled, a dish
// removed or voided, a bill closed, merged, un-merged or moved. Nothing a waiter or a manager does
// to a sent order deletes anything: it writes one of these, and the order's own columns follow.
// `orderId` is the ticket or the bill acted on; `lineId` the dish, for a removal or a void.
// A merge writes one row on the surviving bill (`mergedOrderId` the bill merged into it) and one
// on each addition it re-parented (`mergedOrderId` the bill it came from), all with the same
// `createdAt`, which is how an undo finds exactly what that merge moved. The people are kept as
// ids and survive the account (SetNull): a record outlives the waiter who left.
model OrderChange {
  id            String             @id @default(uuid())
  restaurantId  String
  restaurant    Restaurant         @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  orderId       String
  order         Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  lineId        String?
  line          OrderLine?         @relation(fields: [lineId], references: [id], onDelete: Cascade)
  kind          OrderChangeKind
  quantity      Int?
  reason        OrderChangeReason?
  note          String?
  fromTable     String?
  toTable       String?
  mergedOrderId String?
  status        OrderChangeStatus
  requestedById String?
  requestedBy   User?              @relation("OrderChangeRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)
  decidedById   String?
  decidedBy     User?              @relation("OrderChangeDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt     DateTime?
  source        ChangeSource       @default(STAFF)
  createdAt     DateTime           @default(now())
  posOutbox     PosOutbox[]

  @@index([orderId])
  @@index([restaurantId, createdAt])
}

// A staff device's Web Push subscription (server/push.ts): the browser's endpoint and its two
// keys, the app it was made for (`board`: a kitchen board; `waiter`: the waiter's phone) and who
// was signed in. One row per endpoint: a device that subscribes again, after a sign-in as someone
// else or on another restaurant, moves its row. A send re-checks that the user still works the
// restaurant, so a person removed from it stops being woken without anybody deleting this row.
model PushSubscription {
  id           String     @id @default(uuid())
  endpoint     String     @unique
  p256dh       String
  auth         String
  app          String // board | waiter (lib/schemas/push.ts, STAFF_PUSH_APPS)
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())
  lastUsedAt   DateTime?

  @@index([restaurantId, app])
}

model UserSessionLog {
  id        String   @id @default(uuid())
  userId    String
  action    String // 'LOGIN' | 'LOGOUT'
  device    String? // 'mobile' | 'desktop' | 'tablet'
  ipAddress String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
