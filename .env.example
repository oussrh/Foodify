# Example environment variables for Foodify development

# =======================================
# PostgreSQL connection string
# =======================================
DATABASE_URL="postgresql://<user>:<password>@localhost:5432/foodify"

# =======================================
# NextAuth configuration
# =======================================
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-nextauth-secret"

# =======================================
# 📧 Resend (Emails)
# =======================================
RESEND_API_KEY=
# Sender address verified in Resend. Example:
RESEND_FROM="Foodify <no-reply@mooock.com>"
RESEND_DOMAIN="mooock.com"


# =======================================
# ☁️ Cloudinary
# =======================================
CLOUDINARY_CLOUD_NAME=<your-cloud-name>
CLOUDINARY_API_KEY=<your-api-key>
CLOUDINARY_API_SECRET=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=<your-cloud-name>
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=foodify_upload


# Web Push for the staff apps. Set all three or none; empty means push is off.
# Generate once: pnpm exec web-push generate-vapid-keys, and never regenerate:
# new keys cut off every subscribed device.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT=""   # e.g. "mailto:ops@yourdomain.com"


# =======================================
# POS integration
# =======================================
# Encrypts every restaurant's POS credentials (AES-256-GCM): 32 random bytes, base64.
# Generate once: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Never replace it in place: credentials sealed with the old key could no longer be read.
# Empty means connecting a POS is refused ("not configured on this server").
POS_ENCRYPTION_KEY=""
# Optional name stored beside each sealed credential, for a future key rotation. Default: k1.
POS_ENCRYPTION_KEY_ID=""
# Protects the daily outbox job (/api/pos/outbox); Vercel sends it as a bearer token.
# At least 16 characters. Empty means the job refuses every call.
CRON_SECRET=""