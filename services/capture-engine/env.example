# Copy to .env (next to docker-compose.yml). Never commit .env.

# Shared with Foodify (its CAPTURE_ENGINE_SECRET must be the same value). At least 32 characters:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CAPTURE_ENGINE_SECRET=

# Where the Foodify pages that upload videos and show previews are served from, comma-separated.
CAPTURE_ALLOWED_ORIGINS=http://localhost:3000
